{
  "name": "cards",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "nuxt preview",
    "generate": "nuxt generate",
    "simulate": "tsx scripts/simulate-blackjack.ts",
    "check:source": "tsx scripts/check-source-policy.ts",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "test": "npm run check:source && npm run typecheck && npm run test:unit && npm run test:e2e",
    "test:auth": "vitest run tests/unit/auth.test.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "nuxt": "4.5.2",
    "vuetify": "^3.13.7",
    "vuetify-nuxt-module": "^1.0.0-rc.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "sass-embedded": "^1.105.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
